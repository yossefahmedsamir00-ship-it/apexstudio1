rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Replace this placeholder with the trusted administrator UID before deployment.
    // Until then, administrative access fails closed.
    function isAdmin() {
      return request.auth != null
        && request.auth.uid in ['REPLACE_WITH_ADMIN_UID'];
    }

    function validPublicRequest() {
      return request.resource.data.keys().hasAll([
          'name', 'email', 'whatsapp', 'serviceType', 'description',
          'budgetRange', 'timeline', 'source', 'consentToContact',
          'createdAt', 'status'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'whatsapp', 'serviceType', 'description',
          'budgetRange', 'timeline', 'source', 'consentToContact',
          'createdAt', 'status'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 254
        && request.resource.data.whatsapp is string
        && request.resource.data.whatsapp.size() <= 30
        && request.resource.data.serviceType in [
          'website', 'ecommerce', 'ai_solution', 'web_app',
          'mobile_app', 'custom_system', 'not_sure'
        ]
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 5000
        && request.resource.data.budgetRange in [
          'not_sure', 'small', 'medium', 'large'
        ]
        && request.resource.data.timeline in [
          'asap', '1_2_weeks', '1_month', '1_3_months', 'flexible'
        ]
        && request.resource.data.source is string
        && request.resource.data.source.size() <= 100
        && request.resource.data.consentToContact == true
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'new';
    }

    match /siteConfig/{configId} {
      allow get: if isAdmin() || (configId == 'public' && resource.data.isPublic == true);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /services/{serviceId} {
      allow get, list: if isAdmin()
        || (resource.data.status == 'published' && resource.data.isPublic == true);
      allow create, update, delete: if isAdmin();
    }

    match /projects/{projectId} {
      allow get, list: if isAdmin()
        || (resource.data.status == 'published' && resource.data.visibility == 'public');
      allow create, update, delete: if isAdmin();
    }

    match /requests/{requestId} {
      allow create: if validPublicRequest();
      allow get, list, update, delete: if isAdmin();
    }

    // All collections not explicitly defined above are denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
