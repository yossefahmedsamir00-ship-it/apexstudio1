
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#09090d">
<title>ANSTA | Accessories Store</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&display=swap');

:root{
  --bg:#09090d;
  --panel:#15151e;
  --gold:#e8c36a;
  --purple:#a855f7;
  --text:#fff;
  --muted:#aaaaba;
  --border:rgba(255,255,255,.09);
}

*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{
  font-family:Cairo,sans-serif;
  background:var(--bg);
  color:var(--text);
}
button,input{font:inherit}
button{cursor:pointer}
a{text-decoration:none;color:inherit}

.glow{
  position:fixed;width:350px;height:350px;
  border-radius:50%;filter:blur(120px);
  opacity:.13;z-index:-1;pointer-events:none;
}
.glow.one{background:#8b32ff;top:0;right:-130px}
.glow.two{background:#d8a83e;bottom:0;left:-130px}

header{
  position:sticky;top:0;z-index:50;
  background:rgba(9,9,13,.9);
  backdrop-filter:blur(18px);
  border-bottom:1px solid var(--border);
}
.nav{
  max-width:1250px;margin:auto;padding:14px 20px;
  display:flex;justify-content:space-between;
  align-items:center;gap:15px;
}
.logo{font-size:27px;font-weight:900;letter-spacing:3px;color:var(--gold)}
.logo span{color:white}
.nav-links{display:flex;gap:22px;font-size:13px}
.nav-links a:hover{color:var(--gold)}
.nav-actions{display:flex;gap:8px}
.icon-btn{
  background:#191923;color:white;
  border:1px solid var(--border);
  border-radius:11px;padding:9px 13px;
}
.icon-btn:hover{border-color:var(--gold)}
.count{
  background:var(--gold);color:#111;
  border-radius:50%;padding:1px 6px;
}

.hero{
  max-width:1250px;margin:auto;
  min-height:420px;padding:75px 22px;
  display:flex;align-items:center;position:relative;
  overflow:hidden;
}
.hero-content{max-width:680px;z-index:2}
.eyebrow{color:var(--gold);letter-spacing:3px;font-size:12px}
.hero h1{font-size:clamp(42px,7vw,78px);line-height:1.25;margin:15px 0}
.hero h1 span{
  background:linear-gradient(90deg,#fff,var(--gold),var(--purple));
  background-clip:text;-webkit-background-clip:text;color:transparent;
}
.hero p{color:var(--muted);line-height:2;max-width:520px}
.orb{
  position:absolute;left:8%;top:50%;
  transform:translateY(-50%);
  width:260px;height:260px;border-radius:50%;
  background:radial-gradient(circle at 35% 30%,#e8c36a,#743ba3 45%,#16101f 75%);
  filter:drop-shadow(0 0 60px #a855f744);
  animation:float 5s ease-in-out infinite;
}
@keyframes float{50%{margin-top:-18px}}

.primary{
  border:0;background:linear-gradient(110deg,#f4d58a,#c28b32);
  color:#111;font-weight:900;padding:12px 22px;
  border-radius:11px;transition:.25s;
}
.primary:hover{transform:scale(1.04);box-shadow:0 8px 30px #e8c36a44}
.hero .primary{display:inline-block;margin-top:23px}

.section{max-width:1250px;margin:auto;padding:35px 22px 65px}
.heading{display:flex;justify-content:space-between;align-items:end;margin-bottom:23px}
.heading h2{font-size:27px}
.heading p{font-size:12px;color:var(--muted)}

.tools{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:22px}
.search{
  flex:1;min-width:210px;background:var(--panel);
  border:1px solid var(--border);color:white;
  padding:12px;border-radius:11px;outline:none;
}
.search:focus{border-color:var(--gold)}
.filters{display:flex;gap:7px;flex-wrap:wrap}
.filter{
  border:1px solid var(--border);background:#191923;
  color:#ddd;padding:8px 13px;border-radius:9px;font-size:12px;
}
.filter.active,.filter:hover{background:var(--gold);color:#111}

.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:17px}
.card{
  background:linear-gradient(145deg,#191923,#101016);
  border:1px solid var(--border);border-radius:16px;
  overflow:hidden;transition:.3s;animation:appear .4s ease both;
}
.card:hover{transform:translateY(-6px);border-color:#e8c36a77}
@keyframes appear{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
.product-image{height:205px;position:relative;cursor:pointer;overflow:hidden;background:#222}
.product-image img{width:100%;height:100%;object-fit:cover;transition:.4s}
.card:hover .product-image img{transform:scale(1.08)}
.tag{
  position:absolute;top:10px;right:10px;
  background:var(--gold);color:#111;
  font-size:10px;font-weight:900;padding:4px 8px;border-radius:6px;
}
.info{padding:13px}
.category{color:var(--gold);font-size:11px}
.name{font-size:15px;font-weight:800;margin:5px 0}
.description{font-size:11px;color:var(--muted);height:23px;overflow:hidden}
.bottom{display:flex;justify-content:space-between;align-items:center;margin-top:12px}
.price{color:var(--gold);font-size:16px;font-weight:900}
.old{color:#777;text-decoration:line-through;font-size:10px}
.add{
  background:#29232d;color:var(--gold);
  border:1px solid #55432b;padding:8px 10px;
  border-radius:8px;font-size:11px;
}
.add:hover{background:var(--gold);color:#111}
.buy{width:100%;margin-top:11px;padding:9px}

.overlay{
  display:none;position:fixed;inset:0;z-index:100;
  background:#000b;backdrop-filter:blur(8px);
  align-items:center;justify-content:center;padding:15px;
}
.overlay.show{display:flex}
.modal{
  background:#15151e;border:1px solid var(--border);
  width:min(500px,100%);max-height:90vh;overflow:auto;
  border-radius:18px;padding:20px;animation:appear .2s ease;
}
.modal-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:17px}
.close{
  background:#292933;border:0;color:white;
  width:34px;height:34px;border-radius:8px;
}
.detail-image{width:100%;height:250px;object-fit:cover;border-radius:12px}
.detail-description{color:var(--muted);font-size:13px;line-height:2;margin:10px 0}
.detail-price{font-size:23px;color:var(--gold);font-weight:900}

.cart-item{
  display:flex;align-items:center;gap:12px;
  border-bottom:1px solid var(--border);padding:12px 0;
}
.cart-item img{width:65px;height:65px;object-fit:cover;border-radius:9px}
.cart-item-info{flex:1;font-size:13px}
.cart-item-info small{display:block;color:var(--gold)}
.qty{display:flex;align-items:center;gap:8px;margin-top:6px}
.qty button{
  background:#292933;border:0;color:white;
  width:24px;height:24px;border-radius:6px;
}
.remove{background:none;border:0;color:#ff7777;font-size:11px}
.total{display:flex;justify-content:space-between;padding:17px 0;font-weight:900}
.full{width:100%;margin-top:10px}
.empty{text-align:center;padding:30px;color:var(--muted)}
footer{
  border-top:1px solid var(--border);padding:30px;
  text-align:center;color:var(--muted);font-size:12px;
}
footer strong{color:var(--gold)}

@media(max-width:900px){
  .grid{grid-template-columns:repeat(3,minmax(0,1fr))}
  .orb{left:-80px;opacity:.4}
}
@media(max-width:650px){
  .nav-links{display:none}
  .logo{font-size:22px}
  .hero{padding:60px 20px;min-height:370px}
  .orb{width:170px;height:170px;left:-80px;top:70%}
  .grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
  .product-image{height:155px}
  .info{padding:10px}
  .name{font-size:13px}
  .price{font-size:13px}
  .heading h2{font-size:21px}
}
</style>
</head>

<body>

<div class="glow one"></div>
<div class="glow two"></div>

<header>
<nav class="nav">
  <a href="#home" class="logo">AN<span>STA</span></a>
  <div class="nav-links">
    <a href="#home">الرئيسية</a>
    <a href="#products">المنتجات</a>
    <a href="#products" data-nav="رجالي">رجالي</a>
    <a href="#products" data-nav="حريمي">حريمي</a>
  </div>
  <div class="nav-actions">
    <button class="icon-btn" id="openCart">
      🛒 السلة <span class="count" id="cartCount">0</span>
    </button>
  </div>
</nav>
</header>

<section class="hero" id="home">
  <div class="hero-content">
    <div class="eyebrow">THE FUTURE OF ACCESSORIES</div>
    <h1>أسلوبك...<br><span>هو هويتك.</span></h1>
    <p>اكتشف عالم ANSTA من الإكسسوارات العصرية. اختيارات مميزة وأناقة تناسب كل لحظة.</p>
    <a href="#products" class="primary">اكتشف المنتجات ←</a>
  </div>
  <div class="orb"></div>
</section>

<section class="section" id="products">
  <div class="heading">
    <div>
      <h2>اكتشف مجموعتنا</h2>
      <p>اختار القطعة اللي تعبر عنك</p>
    </div>
    <p>100 منتج</p>
  </div>

  <div class="tools">
    <input class="search" id="search" placeholder="ابحث عن منتج...">
    <div class="filters">
      <button class="filter active" data-filter="الكل">الكل</button>
      <button class="filter" data-filter="رجالي">رجالي</button>
      <button class="filter" data-filter="حريمي">حريمي</button>
      <button class="filter" data-filter="ساعات">ساعات</button>
      <button class="filter" data-filter="نظارات">نظارات</button>
      <button class="filter" data-filter="خواتم">خواتم</button>
      <button class="filter" data-filter="سلاسل">سلاسل</button>
      <button class="filter" data-filter="أساور">أساور</button>
    </div>
  </div>

  <div class="grid" id="grid"></div>
</section>

<footer><strong>ANSTA</strong> — Accessories for Every Identity © 2026</footer>

<!-- تفاصيل المنتج -->
<div class="overlay" id="detailOverlay">
  <div class="modal">
    <div class="modal-head">
      <strong>تفاصيل المنتج</strong>
      <button class="close" data-close="detailOverlay">✕</button>
    </div>
    <div id="detailContent"></div>
  </div>
</div>

<!-- السلة -->
<div class="overlay" id="cartOverlay">
  <div class="modal">
    <div class="modal-head">
      <strong>سلة مشترياتك 🛒</strong>
      <button class="close" data-close="cartOverlay">✕</button>
    </div>
    <div id="cartContent"></div>
  </div>
</div>

<script>
"use strict";

/* إعدادات المتجر */
const LOGIN_URL =
  "https://constant-followed-address-bee.trycloudflare.com";

const images=[
 "https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=700",
 "https://images.unsplash.com/photo-1611591437281-460bfbe1220a?w=700",
 "https://images.unsplash.com/photo-1617038220319-276d3cfab638?w=700",
 "https://images.unsplash.com/photo-1506629905607-d9f9c5c6a8a0?w=700",
 "https://images.unsplash.com/photo-1572635196237-14b3f281503f?w=700",
 "https://images.unsplash.com/photo-1605100804763-247f67b3557e?w=700",
 "https://images.unsplash.com/photo-1611652022419-a9419f74343d?w=700",
 "https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=700"
];

const types={
 "ساعات":["ساعة كلاسيك","ساعة ستيل","ساعة مودرن","ساعة فاخرة","ساعة يومية"],
 "نظارات":["نظارة شمسية","نظارة Urban","نظارة Classic","نظارة Premium","نظارة Modern"],
 "سلاسل":["سلسلة ستانلس","سلسلة ذهبية","سلسلة Silver","سلسلة Luxury","سلسلة Minimal"],
 "خواتم":["خاتم ستيل","خاتم Classic","خاتم هندسي","خاتم Premium","خاتم Modern"],
 "أساور":["إسورة جلد","إسورة ستيل","إسورة Minimal","إسورة فاخرة","إسورة Classic"]
};

const descriptions={
 "ساعات":"تصميم أنيق بخامات مميزة يناسب الاستخدام اليومي والمناسبات.",
 "نظارات":"تصميم عصري بإطلالة مميزة يناسب مختلف الأوقات.",
 "سلاسل":"قطعة أنيقة بتفاصيل دقيقة ولمسة عصرية.",
 "خواتم":"تصميم مميز يضيف لمسة مختلفة لإطلالتك.",
 "أساور":"إكسسوار أنيق بتصميم مريح وسهل التنسيق."
};

/* إنشاء المنتجات */
const products=[];

for(let i=1;i<=100;i++){
 const audience=i%2===0?"حريمي":"رجالي";
 const category=Object.keys(types)[Math.floor((i-1)/2)%5];
 const list=types[category];
 const name=list[Math.floor((i-1)/10)%list.length];
 const basePrice=150+(i*73)%850;
 const discount=i%3===0?15:i%5===0?10:0;

 products.push({
  id:i,
  name:name+" "+String(i).padStart(2,"0"),
  audience,
  category,
  price:Math.round(basePrice*(1-discount/100)),
  oldPrice:discount?basePrice:null,
  discount,
  image:images[(i-1)%images.length],
  description:descriptions[category],
  rating:(4+(i%10)/10).toFixed(1)
 });
}

/* حالة التطبيق */
let filter="الكل";
let cart=JSON.parse(localStorage.getItem("ansta_cart")||"[]");

const grid=document.getElementById("grid");
const search=document.getElementById("search");

/*
  نظام تسجيل الدخول:
  - تفاصيل المنتج متاحة للجميع.
  - إضافة المنتج للسلة تتطلب تسجيل الدخول.
  - نحفظ المنتج مؤقتاً قبل الانتقال.
  - صفحة تسجيل الدخول يجب أن تعيد المستخدم إلى المتجر
    بعد نجاح المصادقة، مع آلية تحقق موثوقة.
*/

function requestLogin(productId){
 const product=products.find(p=>p.id===Number(productId));
 if(!product)return;

 sessionStorage.setItem(
  "ansta_pending_product",
  JSON.stringify(product)
 );

 const returnUrl=window.location.origin+window.location.pathname;

 const destination=new URL(LOGIN_URL);
 destination.searchParams.set("returnUrl",returnUrl);
 destination.searchParams.set("source","ansta");

 window.location.href=destination.toString();
}

/* إضافة المنتج للسلة بعد إثبات تسجيل الدخول */
function addToCartAfterLogin(productId){
 const product=products.find(p=>p.id===Number(productId));
 if(!product)return;

 const existing=cart.find(p=>p.id===product.id);

 if(existing)existing.quantity++;
 else cart.push({...product,quantity:1});

 saveCart();
 renderCart();
}

/*
  لا نعتبر مجرد الرجوع من رابط تسجيل الدخول دليلاً
  على نجاح تسجيل الدخول. يلزم ربط Firebase Auth أو
  جلسة موثوقة من خادم تسجيل الدخول.
*/
function saveCart(){
 localStorage.setItem("ansta_cart",JSON.stringify(cart));
 updateCount();
}

function updateCount(){
 document.getElementById("cartCount").textContent=
  cart.reduce((sum,item)=>sum+item.quantity,0);
}

/* عرض المنتجات */
function renderProducts(){
 const query=search.value.trim().toLowerCase();

 const result=products.filter(p=>{
  const searchMatch=
   p.name.toLowerCase().includes(query)||
   p.category.toLowerCase().includes(query)||
   p.audience.toLowerCase().includes(query);

  const filterMatch=
   filter==="الكل"||p.category===filter||p.audience===filter;

  return searchMatch&&filterMatch;
 });

 if(!result.length){
  grid.innerHTML='<div class="empty">لا توجد منتجات مطابقة.</div>';
  return;
 }

 grid.innerHTML=result.map(p=>`
  <article class="card">
   <div class="product-image" data-detail="${p.id}">
    <img src="${p.image}" alt="${p.name}" loading="lazy">
    ${p.discount?`<span class="tag">خصم ${p.discount}%</span>`:""}
   </div>
   <div class="info">
    <div class="category">${p.audience} · ${p.category}</div>
    <div class="name">${p.name}</div>
    <div class="description">${p.description}</div>
    <div class="bottom">
     <div>
      <span class="price">${p.price} ج.م</span>
      ${p.oldPrice?`<span class="old">${p.oldPrice}</span>`:""}
     </div>
     <button class="add" data-add="${p.id}">إضافة للسلة +</button>
    </div>
    <button class="primary buy" data-buy="${p.id}">شراء الآن</button>
   </div>
  </article>
 `).join("");
}

/* تفاصيل المنتج */
function showDetail(id){
 const p=products.find(item=>item.id===Number(id));
 if(!p)return;

 document.getElementById("detailContent").innerHTML=`
  <img class="detail-image" src="${p.image}" alt="${p.name}">
  <div class="category">${p.audience} · ${p.category}</div>
  <h2 style="margin:8px 0">${p.name}</h2>
  <div class="detail-price">${p.price} جنيه</div>
  ${p.oldPrice?`<p class="old">السعر السابق: ${p.oldPrice} جنيه</p>`:""}
  <p class="detail-description">${p.description}</p>
  <p style="color:var(--gold)">⭐ ${p.rating} / 5</p>
  <button class="primary full" data-add="${p.id}">إضافة إلى السلة</button>
  <button class="primary full" data-buy="${p.id}">شراء الآن</button>
 `;

 openOverlay("detailOverlay");
}

/* السلة */
function renderCart(){
 const container=document.getElementById("cartContent");

 if(!cart.length){
  container.innerHTML='<div class="empty">السلة فارغة حاليًا 🛒</div>';
  return;
 }

 const total=cart.reduce((sum,p)=>sum+p.price*p.quantity,0);

 container.innerHTML=`
  ${cart.map(p=>`
   <div class="cart-item">
    <img src="${p.image}" alt="${p.name}">
    <div class="cart-item-info">
     <strong>${p.name}</strong>
     <small>${p.price} جنيه</small>
     <div class="qty">
      <button data-change="${p.id}" data-amount="1">+</button>
      <span>${p.quantity}</span>
      <button data-change="${p.id}" data-amount="-1">−</button>
      <button class="remove" data-remove="${p.id}">حذف</button>
     </div>
    </div>
   </div>
  `).join("")}
  <div class="total">
   <span>الإجمالي</span>
   <span style="color:var(--gold)">${total} جنيه</span>
  </div>
  <button class="primary full" id="checkout">إتمام الشراء ←</button>
 `;
}

function changeQuantity(id,amount){
 const item=cart.find(p=>p.id===Number(id));
 if(!item)return;
 item.quantity+=amount;
 if(item.quantity<=0)cart=cart.filter(p=>p.id!==Number(id));
 saveCart();
 renderCart();
}

function removeItem(id){
 cart=cart.filter(p=>p.id!==Number(id));
 saveCart();
 renderCart();
}

/* النوافذ */
function openOverlay(id){
 document.getElementById(id).classList.add("show");
}

function closeOverlay(id){
 document.getElementById(id).classList.remove("show");
}

document.querySelectorAll("[data-close]").forEach(btn=>{
 btn.addEventListener("click",()=>closeOverlay(btn.dataset.close));
});

document.querySelectorAll(".overlay").forEach(el=>{
 el.addEventListener("click",e=>{
  if(e.target===el)el.classList.remove("show");
 });
});

/* الأحداث */
document.addEventListener("click",e=>{
 const detail=e.target.closest("[data-detail]");
 const add=e.target.closest("[data-add]");
 const buy=e.target.closest("[data-buy]");
 const change=e.target.closest("[data-change]");
 const remove=e.target.closest("[data-remove]");

 if(detail)showDetail(detail.dataset.detail);

 if(add){
  // لا نضيف المنتج قبل تسجيل الدخول.
  closeOverlay("detailOverlay");
  requestLogin(add.dataset.add);
 }

 if(buy)requestLogin(buy.dataset.buy);

 if(change)changeQuantity(change.dataset.change,Number(change.dataset.amount));

 if(remove)removeItem(remove.dataset.remove);

 if(e.target.id==="openCart"){
  renderCart();
  openOverlay("cartOverlay");
 }

 if(e.target.id==="checkout"){
  if(!cart.length)return;
  sessionStorage.setItem("ansta_pending_cart",JSON.stringify(cart));
  const destination=new URL(LOGIN_URL);
  destination.searchParams.set("returnUrl",window.location.origin+window.location.pathname);
  destination.searchParams.set("source","ansta");
  window.location.href=destination.toString();
 }
});

/* البحث والتصنيفات */
search.addEventListener("input",renderProducts);

document.querySelectorAll("[data-filter]").forEach(btn=>{
 btn.addEventListener("click",()=>{
  filter=btn.dataset.filter;
  document.querySelectorAll("[data-filter]").forEach(b=>{
   b.classList.toggle("active",b===btn);
  });
  renderProducts();
 });
});

document.querySelectorAll("[data-nav]").forEach(link=>{
 link.addEventListener("click",()=>{
  filter=link.dataset.nav;
  renderProducts();
 });
});

/* تشغيل */
renderProducts();
updateCount();
</script>
</body>
</html>
